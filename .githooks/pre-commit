#!/usr/bin/env bash
# Blocks commits that add secrets, sensitive files or personal/org identifiers.
# Enable once per clone:  git config core.hooksPath .githooks
# Personal deny-list (not tracked): .githooks/denylist.local, one extended regex per line.
# Bypass a reviewed false positive on one line with the marker:  allow-sensitive
# CI: set SCAN_RANGE (e.g. base...head) to scan a commit range instead of the index.
set -u
cd "$(git rev-parse --show-toplevel)"
if [ -n "${SCAN_RANGE:-}" ]; then diff_src=("$SCAN_RANGE"); else diff_src=(--cached); fi
fail=0
report() { printf '  \033[31m✗\033[0m %s\n' "$1" >&2; fail=1; }

# 1. Sensitive file names/paths (staged adds/modifies/renames)
name_re='(^|/)(\.env(\..*)?|\.netrc|\.npmrc|\.pypirc|id_(rsa|dsa|ecdsa|ed25519)|credentials(\.json)?|state\.json|config\.json|\.DS_Store|Thumbs\.db)$|\.(pem|key|p12|pfx|jks|keystore|tfstate|tfvars)(\.backup)?$|\.tfstate\.backup$'
while IFS= read -r f; do
  [[ "$f" =~ \.example(\.|$) ]] && continue
  if [[ "$f" =~ $name_re ]]; then report "sensitive file staged: $f"; fi
done < <(git diff "${diff_src[@]}" --name-only --diff-filter=ACMR)

# 2. Secret patterns in added lines
secret_re='AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{50,}|xox[abprs]-[A-Za-z0-9-]{10,}|sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|AIza[0-9A-Za-z_-]{35}|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}|(password|passwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"'$<{ ]{8,}["'"'"']|(SharedAccessKey|AccountKey)=[A-Za-z0-9+/=]{20,}|[a-z0-9]{52}[[:space:]]*$'
# 3. Insecure patterns
insecure_re='curl[^|]*\|[[:space:]]*(sudo[[:space:]]+)?(ba)?sh|Invoke-Expression[[:space:]]+\(?[[:space:]]*(iwr|irm|Invoke-WebRequest|Invoke-RestMethod)|iwr[^|]*\|[[:space:]]*iex|(-k|--insecure)[[:space:]].*https?://|NODE_TLS_REJECT_UNAUTHORIZED[[:space:]]*=[[:space:]]*0|verify[[:space:]]*=[[:space:]]*False|ConvertTo-SecureString[^|]*-AsPlainText|chmod[[:space:]]+(-R[[:space:]]+)?777'
# 4. Personal/org identifiers: email addresses other than placeholders, plus local deny-list
email_re='[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
safe_email_re='@(example\.(com|org|net)|users\.noreply\.github\.com|anthropic\.com)|noreply@|you@|your-?[a-z]*@'
deny_file=.githooks/denylist.local
denylist=""
[ -f "$deny_file" ] && denylist=$(grep -vE '^[[:space:]]*(#|$)' "$deny_file" | paste -sd'|' -)

file=""; line=0
while IFS= read -r l; do
  case "$l" in
    '+++ b/'*) file=${l#+++ b/}; continue ;;
    '+++ '*|'--- '*|diff*|index*|new*|deleted*|similarity*|rename*|Binary*) continue ;;
    '@@ '*) line=$(sed -E 's/^@@ -[0-9,]+ \+([0-9]+).*/\1/' <<<"$l"); continue ;;
    +*) body=${l:1}; ;;
    *) continue ;;
  esac
  here="$file:$line"; line=$((line+1))
  [[ "$body" == *allow-sensitive* ]] && continue
  [[ "$file" == .githooks/pre-commit ]] && continue
  if grep -Eiq -- "$secret_re" <<<"$body"; then report "possible secret at $here"; fi
  if grep -Eiq -- "$insecure_re" <<<"$body"; then report "insecure pattern at $here"; fi
  if m=$(grep -Eio -- "$email_re" <<<"$body" | grep -Eiv -- "$safe_email_re" | head -1) && [ -n "$m" ]; then
    report "email address at $here: $m"
  fi
  if [ -n "$denylist" ] && grep -Eiq -- "$denylist" <<<"$body"; then report "deny-listed term at $here"; fi
done < <(git diff "${diff_src[@]}" -U0 --no-color --diff-filter=ACMR)

if [ "$fail" -ne 0 ]; then
  printf '\nCommit blocked. Remove the item, or append "allow-sensitive" to a reviewed false-positive line.\n' >&2
  exit 1
fi
